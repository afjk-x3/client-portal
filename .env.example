# Copy to .env.local. Local keys come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave RESEND_API_KEY and SMTP_HOST empty locally: emails are logged instead of sent.
RESEND_API_KEY=
# SMTP instead of Resend, for example Gmail: smtp.gmail.com, port 465, the address, and an app password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@example.com
CRON_SECRET=local-cron-secret
